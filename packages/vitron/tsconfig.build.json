{
    "extends": "../../tsconfig.build.json",

    "compilerOptions": {
        "outDir": "./dist",
        "declarationDir": "dist",
        "declaration": true,

        "importHelpers": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "ESNext"]
    },

    "include": [
        "src/**/*.ts"
    ]
}
